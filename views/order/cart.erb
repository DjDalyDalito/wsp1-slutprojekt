<section class="section">
  <div class="container">
    <h2>Kundvagn</h2>
    <p class="msg">En produkt. Enkel checkout.</p>

    <div class="cart">
      <div class="cart-item">
        <img class="img" src="/images/keyboard.png" alt="Produktbild" width="50%" />
        <div class="cart-other">
          <div class="cart-title">TyperBuddy</div>
          <div class="msg">449 kr / st</div>
        </div>

        <div class="cart-grejer">
          <form action="/cart/delete" method="post" class="inline">
            <button class="btn2" type="submit">−</button>
          </form>
          <div class="qty"><%= @qty %></div>
          <form action="/cart/new" method="post" class="inline">
            <button class="btn2" type="submit">+</button>
          </form>
        </div>

        <div class="cart-summa"><%= money_kr(@subtotal_ore) %></div>

        <div class="cart-checkout">
        <h3>Checkout</h3>
        <div class="row"><span>Delsumma</span><span><%= money_kr(@subtotal_ore) %></span></div>
        <div class="row"><span>Frakt</span><span>0 kr</span></div>
        <div class="row total"><span>Totalt</span><span><%= money_kr(@subtotal_ore) %></span></div>

        <form action="/checkout" method="post" class="checkout-form">
          <label>
            Namn
            <input name="name" required placeholder="Ditt namn" />
          </label>
          <label>
            E-post
            <input name="email" type="email" required placeholder="din@email.se" />
          </label>

          <button class="btn3" type="submit" <%= @qty.to_i <= 0 ? "disabled" : "" %>>
            Betala
          </button>
          
        </form>
      </div>
      </div>
    </div>
  </div>
</section>

<h2>Meddelanden</h2>

<table>
  <thead>
    <tr>
      <th>Namn</th>
      <th>Email</th>
      <th>Ämne</th>
      <th>Meddelande</th>
    </tr>
  </thead>
  <tbody>
    <% @messages.each do |message| %>
      <tr>
        <td><%= message["name"] %></td>
        <td><%= message["email"] %></td>
        <td><%= message["subject"] %></td>
        <td><%= message["message"] %></td>
      </tr>
    <% end %>
  </tbody>
</table>
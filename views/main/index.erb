<section class="produkt">
  <div class="container grid">
    <div>
      <div class="tag">
        Prestera 10x bättre
      </div>

      <h1 class="title">
        keyboard <span class="accent">Bla</span>
      </h1>

      <p class="text">
        Blablablablabla
      </p>

      <div class="actions">
        <form action="/cart/new" method="post" class="inline">
          <button class="btn" type="submit">Köp nu · 449 kr</button>
        </form>
        <a class="btn2" href="#funktioner">Läs mer</a>
      </div>

      <div class="checks">
        <span>Fri frakt</span>
        <span>30 dagars öppet köp</span>
        <span>Snabb leverans</span>
      </div>
    </div>

    <div class="card">
      <img class="img" src="/images/keyboard.png" alt="Produktbild" width="50%"/>
    </div>
  </div>
</section>

<section id="funktioner" class="section">
  <div class="container">
    <h2>Ett enkelt pris, allt inkluderat</h2>
    <p class="msg2">Inga dolda avgifter. Köp en gång, använd när du vill.</p>

    <div class="pricing">
      <div class="price-card">
        <div class="price-left">
          <img class="img" src="/images/keyboard.png" alt="Produktbild" width="50%" />
        </div>
        <div class="price-right">
          <div class="price">449 kr</div>
          <div class="msg">inkl. moms · fri frakt</div>

          <ul class="checklist">
            <li>BootingKeyboard</li>
            <li>USB-C kabel</li>
            <li>Snabbstart-guide</li>
            <li>2 års garanti</li>
            <li>30 dagar öppet köp</li>
          </ul>

          <form action="/cart/new" method="post">
            <button class="btn3" type="submit">Lägg i kundvagn</button>
          </form>

          <div class="msg3">Leverans: 2–4 arbetsdagar.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="kontakt" class="section">
  <div class="container">
    <h2>Kontakta oss</h2>
    <p class="msg2">Har du frågor? Kontakta oss så hjälper vi dig.</p>

    <form class="contact" action="/message" method="post">
      <div class="grid2">
        <label>
          Namn
          <input name="name" placeholder="Ditt namn" required />
        </label>
        <label>
          E-post
          <input name="email" type="email" placeholder="din@email.se" required />
        </label>
      </div>

      <label>
        Ämne
        <input name="subject" placeholder="Vad gäller det?" />
      </label>

      <label>
        Meddelande
        <textarea name="message" rows="5" placeholder="Skriv ditt meddelande..." required></textarea>
      </label>

      <button class="btn" type="submit">Skicka meddelande</button>
    </form>
  </div>
</section>

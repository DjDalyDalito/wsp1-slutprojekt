<!doctype html>
<html lang="sv">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Booting</title>
  <link rel="stylesheet" href="/public/css/styles.css" />
</head>
<body>
  <header class="topbar">
    <div class="container nav">
      <a class="brand" href="/">
        <span class="brand-mark">BK</span>
        <span class="brand-name">BootingKeyboard</span>
      </a>

      <nav class="menu">
        <a href="#funktioner">Funktioner</a>
        <a href="#produkt">Produkt</a>
        <a href="#recensioner">Recensioner</a>
        <a href="#faq">FAQ</a>
      </nav>

      <div class="nav-cta">
        <a class="cartlink" href="/order/cart" aria-label="Kundvagn">
          Kundvagn <span class="pill"><%= cart_qty %></span>
        </a>

        <% if logged_in? %>
          <form action="/logout" method="post" style="display:inline;">
            <button class="btn btn-primary" type="submit">Logga ut</button>
          </form>
          <% if admin? %>
            <a href="/admin/messages">Meddelanden</a>
          <% end %>
        <% else %>
          <a class="btn btn-primary" href="/login">Logga in</a>
          <a class="btn btn-primary" href="/register">Registrera dig</a>
        <% end %>
      </div>
    </div>
  </header>

  <main>
    <%= yield %> <!-- Så att man kan ha flera .erb filer i samma vy-->
  </main>
</body>
</html>